# TRUE disables Gemini UI and generation endpoints. FALSE enables them.
PROD=FALSE

# Used by the initial Node health server.
PORT=3001
# Interface the API binds to; keep 127.0.0.1 locally, use 0.0.0.0 in Docker (compose sets it).
HOST=127.0.0.1

# Reserved for the integrations described in docs/TECHSTACK.md.
GEMINI_API_KEY=
GEMINI_MODEL=
DATABASE_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

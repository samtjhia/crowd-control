{
  "name": "@crowd-control/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @crowd-control/contract",
    "dev": "node --env-file-if-exists=../.env --watch-path=src src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node --env-file-if-exists=../.env dist/index.js"
  },
  "dependencies": {
    "@crowd-control/contract": "*",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
